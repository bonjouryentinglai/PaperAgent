# Runtime choices only. Never place OAuth tokens or API keys in this file.
PAPER_AGENT_PI_BIN_DIR=/home/root/node/bin
PAPER_AGENT_PROVIDER=openai-codex
PAPER_AGENT_MODEL=gpt-5.6-sol

# Pi accepts: off, minimal, low, medium, high, xhigh, max.
# `off` gives the fastest response path.
PAPER_AGENT_THINKING=off

# Relative size of Chinese glyphs beside Latin handwriting.
PAPER_AGENT_CJK_SCALE=0.78

# GPT Image uses the same ChatGPT OAuth login. Image size and quality affect
# latency; Paper Agent does not silently lower them when thinking is off.
PAPER_AGENT_IMAGE_RESPONSES_MODEL=gpt-5.6-sol
PAPER_AGENT_IMAGE_MODEL=gpt-image-2
PAPER_AGENT_IMAGE_SIZE=1024x1024
PAPER_AGENT_IMAGE_QUALITY=medium

# Final native notebook image bounds after the generated PNG is decoded and
# normalized. Allowed range is 128..800 per side; images are never enlarged.
PAPER_AGENT_IMAGE_MAX_WIDTH=620
PAPER_AGENT_IMAGE_MAX_HEIGHT=620
